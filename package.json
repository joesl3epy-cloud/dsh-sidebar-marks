{
  "name": "dsh-sidebar-marks",
  "version": "1.0.0",
  "description": "Session Marks｜会话标记：极简会话管理：待回看、收藏、跨工作区查找与可恢复删除",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "sidebar",
    "session",
    "marks",
    "favorites",
    "cordis"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "test",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "DEVELOPMENT.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joesl3epy-cloud/dsh-sidebar-marks.git"
  },
  "homepage": "https://github.com/joesl3epy-cloud/dsh-sidebar-marks#readme",
  "bugs": {
    "url": "https://github.com/joesl3epy-cloud/dsh-sidebar-marks/issues"
  },
  "author": "Jolyon",
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=24"
  }
}
